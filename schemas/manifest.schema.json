{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Exonical/stigctl/schemas/manifest.schema.json",
  "title": "stigctl baseline manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "os",
    "baseline",
    "implementation",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "os": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "major_version"
      ],
      "properties": {
        "family": {
          "type": "string",
          "minLength": 1
        },
        "major_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "version",
        "release",
        "identifier",
        "display_name"
      ],
      "properties": {
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "release": {
          "type": "integer",
          "minimum": 1
        },
        "identifier": {
          "type": "string",
          "minLength": 1
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision"
      ],
      "properties": {
        "revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "development",
        "supported",
        "superseded",
        "retired"
      ]
    }
  }
}
