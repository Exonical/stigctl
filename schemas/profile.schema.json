{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Exonical/stigctl/schemas/profile.schema.json",
  "title": "stigctl applicability profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    }
  }
}
